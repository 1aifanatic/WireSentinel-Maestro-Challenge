      "lengthLimit": 100
    },
    {
      "fieldName": "Action",
      "type": "STRING",
      "displayName": "Requested Action",
      "isRequired": true,
      "lengthLimit": 80
    },
    {
      "fieldName": "Status",
      "type": "STRING",
      "displayName": "Execution Status",
      "isRequired": true,
      "lengthLimit": 120
    },
    {
      "fieldName": "Actor",
      "type": "STRING",
      "displayName": "Actor",
