{
  "inputs": {
    "type": "object",
    "properties": {
      "caseId": { "type": "string", "required": true, "description": "WireSentinel case key" },
      "requestId": { "type": "string", "required": true, "description": "Source request identifier" },
      "customerId": { "type": "string", "required": false },
      "amount": { "type": "number", "required": true },
      "currency": { "type": "string", "required": true },
      "beneficiaryName": { "type": "string", "required": true },
      "beneficiaryCountry": { "type": "string", "required": true },
      "riskScore": { "type": "number", "required": true },
      "riskLevel": { "type": "string", "required": true },
      "status": { "type": "string", "required": false },
      "finalDecision": { "type": "string", "required": false },
      "recommendedDecision": { "type": "string", "required": true },
      "reasonCodes": { "type": "array", "required": true, "items": { "type": "string" } },
      "policyEvidence": { "type": "string", "required": true },
      "ixpEvidence": { "type": "string", "required": true },
      "reviewMode": { "type": "string", "required": true },
      "correlationId": { "type": "string", "required": false },
      "maestroInstanceId": { "type": "string", "required": false },
      "documents": {
        "type": "array",
        "required": false,
        "items": {
          "type": "object",
          "properties": {
            "id": { "type": "string" },
            "fileName": { "type": "string" },
            "documentType": { "type": "string" },
            "classificationConfidence": { "type": "number" },
            "extractionConfidence": { "type": "number" },
            "isSupported": { "type": "boolean" },
            "quarantineReason": { "type": "string" }
          }
        }
      },
      "auditEvents": {
        "type": "array",
        "required": false,
        "items": {
          "type": "object",
          "properties": {
            "id": { "type": "string" },
            "eventType": { "type": "string" },
            "outcome": { "type": "string" },
            "actor": { "type": "string" },
            "actorType": { "type": "string" },
            "occurredAt": { "type": "string" }
          }
        }
      }
    }
  },
  "outputs": {
    "type": "object",
    "properties": {
      "reviewerRationale": { "type": "string", "required": false },
      "reviewOutcome": { "type": "string", "required": true }
    }
  },
  "inOuts": { "type": "object", "properties": {} },
  "outcomes": {
    "type": "object",
    "properties": {
      "Approve": { "type": "string" },
      "Reject": { "type": "string" },
      "Escalate": { "type": "string" }
    }
  }
}
