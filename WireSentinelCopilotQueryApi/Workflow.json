          {
            "Javascript_BuildMaskedResult": {
              "run": {
                "script": {
                  "code": "function records(name){const response=$context.outputs[name]||{};const raw=response.content!==undefined?response.content:response;return Array.isArray(raw)?raw:(Array.isArray(raw.Items)?raw.Items:(Array.isArray(raw.items)?raw.items:(Array.isArray(raw.value)?raw.value:(Array.isArray(raw.Value)?raw.Value:(Array.isArray(raw.records)?raw.records:[])))))}const prep=$context.outputs.Javascript_PrepareRead;const cases=records('QueryCases').map(r=>({CaseKey:r.CaseKey,RequestId:r.RequestId,Status:r.Status,RiskLevel:r.RiskLevel,RiskScore:r.RiskScore,Amount:r.Amount,Currency:r.Currency,BeneficiaryCountry:r.BeneficiaryCountry,FinalDecision:r.FinalDecision,LastAction:r.LastAction,PolicyEvidence:r.PolicyEvidence,CreateTime:r.CreateTime,UpdateTime:r.UpdateTime}));const auditEvents=records('QueryAuditEvents').map(r=>({EventKey:r.EventKey,CaseKey:r.CaseKey,EventType:r.EventType,ActorType:r.ActorType,Outcome:r.Outcome,Summary:r.Summary||r.Description,OccurredAt:r.OccurredAt||r.EventTime||r.CreateTime}));const documents=records('QueryDocuments').map(r=>({DocumentKey:r.DocumentKey,CaseKey:r.CaseKey,DocumentType:r.DocumentType,SourceDocumentId:r.SourceDocumentId,ModelVersion:r.ModelVersion,ExtractionConfidence:r.ExtractionConfidence,ValidationStatus:r.ValidationStatus,IsValid:r.IsValid,CreateTime:r.CreateTime}));const policies=records('QueryPolicies').map(r=>({PolicyKey:r.PolicyKey,PolicyTitle:r.PolicyTitle,SectionName:r.SectionName,PolicyContent:r.PolicyContent,PolicyVersion:r.PolicyVersion,EffectiveDate:r.EffectiveDate}));const citations=[...cases.map(r=>r.CaseKey),...auditEvents.map(r=>r.EventKey),...documents.map(r=>r.DocumentKey),...policies.map(r=>r.PolicyKey)].filter(Boolean);return{success:true,readOnly:true,masked:true,source:'Operational UiPath Data Fabric',userQuery:prep.userQuery,caseKeyFilter:prep.caseKey||null,recordCounts:{cases:cases.length,auditEvents:auditEvents.length,documents:documents.length,policies:policies.length},cases:cases,auditEvents:auditEvents,documents:documents,policies:policies,citations:Array.from(new Set(citations)),safety:{writesPerformed:false,omittedFields:['CustomerId','BeneficiaryName','Actor','FileName','raw extraction payloads']}};",
                  "language": "javascript",
                  "arguments": "${{\n                        \"$context\": $context,\n                        \"$workflow\": $workflow,\n                        \"$input\": $input\n                    }}"
                }
              },
              "export": {
                "as": "{ ...$context, outputs: { ...$context?.outputs, \"Javascript_BuildMaskedResult\": $output } }"
