            "Javascript_PrepareRead": {
              "run": {
                "script": {
                  "code": "const userQuery=String($workflow.input.user_query||'').trim();if(!userQuery)throw new Error('user_query is required');const caseKey=String($workflow.input.case_key||'').trim();const requested=Number($workflow.input.max_records||10);const maxRecords=Math.min(25,Math.max(1,Number.isFinite(requested)?Math.floor(requested):10));const escapeOData=(value)=>String(value).replace(/'/g,\"''\");return{userQuery:userQuery,caseKey:caseKey,maxRecords:maxRecords,caseFilter:caseKey?\"CaseKey='\"+escapeOData(caseKey)+\"'\":\"\"};",
                  "language": "javascript",
                  "arguments": "${{\n                        \"$context\": $context,\n                        \"$workflow\": $workflow,\n                        \"$input\": $input\n                    }}"
                }
              },
              "export": {
                "as": "{ ...$context, outputs: { ...$context?.outputs, \"Javascript_PrepareRead\": $output } }"
              },
              "metadata": {
                "activityType": "JsInvoke",
                "displayName": "Prepare bounded read-only query",
