      "inputs": {
        "script": "var f=($vars.technicalFailure1&&$vars.technicalFailure1.output)||{};var now=new Date().toISOString();var correlation=($vars.intake1&&$vars.intake1.output&&$vars.intake1.output.correlation_id)||$metadata.InstanceId||$metadata.ExecutionId||('TECH-'+Date.now());var caseSuffix=String(correlation).replace(/[^A-Za-z0-9]/g,'').slice(-12)||String(Date.now());var eventSuffix=caseSuffix+'-'+String(Date.now());var caseKey=f.case_id||('WS-TECH-'+caseSuffix);var details={finalStatus:f.final_status||'TechnicalFailureManualReview',riskLevel:f.risk_level||'Unknown',decision:f.decision||'ManualReviewRequired',correlationId:correlation,retryPolicy:'Operator reviews evidence, corrects the failed dependency, then safely replays with the original correlation ID.'};return{audit:{EventKey:'EVT-TECH-'+eventSuffix,CaseKey:caseKey,EventType:'TechnicalFailure',ActorType:'System',Actor:'WireSentinelFlow',Outcome:'ManualReviewRequired',DetailsJson:JSON.stringify(details),CorrelationId:correlation,OccurredAt:now},notification_html:'<h2>WireSentinel technical exception</h2><p><strong>Case:</strong> '+caseKey+'</p><p><strong>Correlation:</strong> '+correlation+'</p><p>The flow failed closed. No production funds movement occurred. Review the audit event, remediate the dependency, and replay using the same correlation ID.</p>'};",
