              "condition": "node.data.inputs.branches.length === 0 && !hasEdgeFromHandle('error')",
              "matchOriginalEdgeByHandle": "default",
              "preserveEdgeId": true,
              "source": "{nodeId}",
              "type": "bpmn:SequenceFlow"
            }
          ]
        }
      },
      "inputDefinition": {
        "type": "object",
        "properties": {
          "branches": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "conditionExpression": {
                  "type": "string"
                }
              }
            }
          },
          "timeout": {
            "type": "string",
            "pattern": "^P(?!$)(\\d+Y)?(\\d+M)?(\\d+W)?(\\d+D)?(T(?=\\d)(\\d+H)?(\\d+M)?(\\d+S)?)?$",
            "errorMessage": {
              "pattern": "Timeout must be in ISO 8601 duration format (e.g., PT15M, PT1H, P1D)"
            }
          },
          "retryCount": {
            "type": "number"
          }
        }
      },
      "inputDefaults": {
        "branches": [],
        "timeout": "PT15M",
        "retryCount": 0
      },
