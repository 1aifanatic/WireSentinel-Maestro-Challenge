      "inputs": {
        "entryPointId": "0af1e5e3-c4cf-42de-9c0d-845990ab6066",
        "isDefaultEntryPoint": true,
        "detail": {
          "connector": "uipath-google-gmail",
          "connectionId": "11111111-1111-4111-8111-111111111111",
          "connectionResourceId": "11111111-1111-4111-8111-111111111111",
          "connectionFolderKey": "00000000-0000-4000-8000-000000000000",
          "eventParameters": {
            "ParentFolders[*].ID": "INBOX"
          },
          "objectName": "Message",
          "eventType": "EMAIL_RECEIVED",
          "eventMode": "polling",
          "filterExpression": "(ParentFolders[?ID=='INBOX']) && ((HasAttachments==`true`))",
