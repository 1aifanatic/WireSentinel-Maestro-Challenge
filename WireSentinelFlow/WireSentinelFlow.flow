    {
      "id": "intake1",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "Validate Bounded Document Intake",
        "icon": "code"
      },
      "inputs": {
        "script": "var e=$vars.wireRequestReceived1.output||{};var directWire=($vars.wire_file&&$vars.wire_file.ID)?$vars.wire_file:null;var directSupporting=($vars.supporting_file&&$vars.supporting_file.ID)?$vars.supporting_file:null;var a=Array.isArray(e.Attachments)?e.Attachments:[];if(directWire){a=[directWire,directSupporting].filter(function(x){return Boolean(x);}).map(function(x,i){return{ID:x.ID,AttachmentID:x.ID,Name:x.FullName||(i===0?'wire-instruction.pdf':'supporting-document.pdf'),MIMEType:x.MimeType||'application/pdf',Size:Number((x.Metadata&&x.Metadata.size)||0)};});e={ID:'DIRECT-DEBUG-'+String(directWire.ID||''),ThreadID:'',Subject:'Governed direct IXP evaluation | '+String(directWire.FullName||''),Body:'Direct file inputs supplied by an authorized debug or evaluation run.',From:{Email:'governed-debug@wiresentinel.internal'},Attachments:a};}if(a.length<1){throw new Error('WireSentinel requires at least one attachment');}var sanitize=function(v){return String(v||'').replace(/[\\r\\n\\t]+/g,' ').slice(0,2000);};var wire=a.filter(function(x){return /wire/i.test(String(x.Name||''));})[0]||a[0];var supporting=a.filter(function(x){return x!==wire&&/(invoice|support|statement)/i.test(String(x.Name||''));})[0]||a.filter(function(x){return x!==wire;})[0]||null;var selected=[wire,supporting].filter(function(x){return Boolean(x);});var extras=a.filter(function(x){return selected.indexOf(x)<0;});var from=(e.From&&e.From.Email)?e.From.Email:'';var correlation=String($metadata.InstanceId||$metadata.ExecutionId||e.ObjectId||e.ID||'');return{attachment_count:a.length,has_supporting:Boolean(supporting),extra_attachment_count:extras.length,wire_attachment:wire,supporting_attachment:supporting,extra_attachments:extras.map(function(x){return{name:x.Name||'',mime_type:x.MIMEType||'',size:x.Size||0,quarantine_reason:'Attachment exceeds bounded two-document intake'};}),correlation_id:correlation,email_context:{message_id:e.ObjectId||e.ID||'',thread_id:e.ThreadID||'',subject:sanitize(e.Subject),body:sanitize(e.Body),from:from,attachment_names:a.map(function(x){return x.Name||'';})}};",
        "errorHandlingEnabled": true
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Validated email metadata and bounded document inventory.",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the script fails.",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "directDocumentsProvided1",
