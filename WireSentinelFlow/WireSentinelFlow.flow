        "icon": "function"
      },
      "inputs": {
        "wire_file": "=js:($vars.wire_file||$vars.materializeWireAttachment1.output.File)",
        "supporting_file": "=js:($vars.supporting_file||($vars.intake1.output.has_supporting?$vars.materializeSupportingAttachment1.output.File:null))",
        "errorHandlingEnabled": true
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Deterministic normalized IXP evidence pack.",
          "source": "=this",
          "var": "output",
          "schema": {
            "type": "object",
            "properties": {
              "content": {
