    {
      "id": "finalize1",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "Finalize Case, Audit, and Notification",
        "icon": "code"
      },
      "inputs": {
        "script": "var p=$vars.policyDecision1.output;var d=$vars.actionDecision1.output;var raw=($vars.bankingAdapter1&&$vars.bankingAdapter1.output)||{};var b=raw.bankingResult||raw;var now=b.processedAtUtc||new Date().toISOString();var held=d.action==='holdAndFileSAR';var status=held?'HeldAndSarFiled':(d.action==='release'?(p.risk_level==='Medium'?'ReleasedAfterVerification':'Released'):(d.action==='reject'?'Rejected':'Held'));var decision=d.case_package.finalDecision;var eventKey=p.case_id+'-'+String(d.action).toUpperCase();var details={riskScore:p.risk_score,riskLevel:p.risk_level,reasonCodes:p.reason_codes,humanDecision:d.human_decision,reviewerNotes:d.reviewer_notes||'',sarReference:d.sar_reference||'',bankingResult:b,policy:p.policy};var audit={EventKey:eventKey,CaseKey:p.case_id,EventType:'WireDecisionExecuted',ActorType:d.human_decision==='NotRequired'?'Automation':'Human',Actor:d.actor,Outcome:status,DetailsJson:JSON.stringify(details),CorrelationId:$vars.intake1.output.correlation_id,OccurredAt:now};var caseUpdate={Status:status,FinalDecision:decision,LastAction:d.action,ClosedAt:now};function esc(v){return String(v===undefined||v===null?'':v).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/'/g,'&#39;');}function pick(o,keys){for(var i=0;i<keys.length;i++){var v=o&&o[keys[i]];if(v!==undefined&&v!==null&&String(v).trim()!=='')return v;}return 'Not provided';}function pct(v){var n=Number(v);if(!isFinite(n)||n<=0)return 'Not reported';if(n<=1)n=n*100;return n.toFixed(1)+'%';}function money(v,c){var n=Number(v);return esc(c||'USD')+' '+(isFinite(n)?n.toLocaleString('en-US',{minimumFractionDigits:2,maximumFractionDigits:2}):esc(v));}function row(label,value,source){return `<tr><td style='padding:9px 12px;border-bottom:1px solid #e7e5e4;font-weight:600;color:#292524'>${esc(label)}</td><td style='padding:9px 12px;border-bottom:1px solid #e7e5e4;color:#44403c'>${esc(value)}</td>${source?`<td style='padding:9px 12px;border-bottom:1px solid #e7e5e4;color:#78716c'>${esc(source)}</td>`:''}</tr>`;}var wi=p.wire||{};var inv=p.invoice||{};var wireDoc=p.wireDocument||{};var invoiceDoc=p.supportingDocument||{};var docs=[{label:'Wire instruction',doc:wireDoc},{label:'Supporting invoice',doc:invoiceDoc}];var docRows=docs.map(function(x){var q=x.doc||{};var state=q.IsSupported===false?'Quarantined':'Received and extracted';return `<tr><td style='padding:9px 12px;border-bottom:1px solid #e7e5e4;font-weight:600'>${esc(x.label)}</td><td style='padding:9px 12px;border-bottom:1px solid #e7e5e4'>${esc(q.FileName||'Not provided')}</td><td style='padding:9px 12px;border-bottom:1px solid #e7e5e4'>${esc(q.DocumentType||'Unknown')}</td><td style='padding:9px 12px;border-bottom:1px solid #e7e5e4'>${esc(pct(q.ExtractionConfidence))}</td><td style='padding:9px 12px;border-bottom:1px solid #e7e5e4'>${esc(state)}</td></tr>`;}).join('');var currency=p.case&&p.case.Currency?p.case.Currency:'USD';var amount=p.case&&p.case.Amount!==undefined?p.case.Amount:pick(wi,['amount','transfer_amount']);var invAmount=pick(inv,['total_amount','invoice_total','amount']);var mismatch=p.policy&&p.policy.invoice_amount_mismatch===true;var extractedRows='';extractedRows+=row('Request ID',p.request_id||pick(wi,['request_id','requestId']),'Wire instruction');extractedRows+=row('Customer ID',pick(wi,['customer_id','customerId']),'Wire instruction');extractedRows+=row('Transfer amount',money(amount,currency),'Wire instruction');extractedRows+=row('Beneficiary',p.case&&p.case.BeneficiaryName?p.case.BeneficiaryName:pick(wi,['beneficiary_name','beneficiaryName']),'Wire instruction');extractedRows+=row('Beneficiary country',p.case&&p.case.BeneficiaryCountry?p.case.BeneficiaryCountry:pick(wi,['beneficiary_country','beneficiaryCountry']),'Wire instruction');extractedRows+=row('Routing / SWIFT',pick(wi,['routing_or_swift','routingNumber','swift_code']),'Wire instruction');extractedRows+=row('Authorized signature',String(pick(wi,['signature_present','signature_flag'])),'Wire instruction');extractedRows+=row('Invoice number',pick(inv,['invoice_number','invoiceNumber','number']),'Supporting invoice');extractedRows+=row('Invoice supplier',pick(inv,['vendor_name','vendorName','supplier_name','supplierName']),'Supporting invoice');extractedRows+=row('Invoice total',invAmount==='Not provided'?'Not provided':money(invAmount,currency),'Supporting invoice');extractedRows+=row('Amount comparison',mismatch?'Mismatch detected':'Amounts consistent','Policy check');var color=p.risk_level==='Critical'?'#B42318':(p.risk_level==='Medium'?'#B54708':'#067647');var table=`width:100%;border-collapse:collapse;font-size:14px`;var html=`<div style='font-family:Segoe UI,Arial,sans-serif;max-width:760px;margin:auto;background:#fff;border:1px solid #e7e5e4;border-radius:14px;overflow:hidden;color:#292524'><div style='background:${color};color:#fff;padding:22px 26px'><div style='font-size:12px;letter-spacing:1.4px'>WIRESENTINEL REVIEW RESULT</div><div style='font-size:25px;font-weight:700;margin-top:4px'>${esc(status)}</div><div style='font-size:13px;margin-top:6px'>Case ${esc(p.case_id)}</div></div><div style='padding:24px 26px'><h3 style='margin:0 0 10px;font-size:17px'>1. PDFs received</h3><table style='${table}'><thead><tr style='background:#f5f5f4;text-align:left'><th style='padding:9px 12px'>Document</th><th style='padding:9px 12px'>File received</th><th style='padding:9px 12px'>Detected type</th><th style='padding:9px 12px'>Confidence</th><th style='padding:9px 12px'>Status</th></tr></thead><tbody>${docRows}</tbody></table><h3 style='margin:24px 0 10px;font-size:17px'>2. Data extracted from the PDFs</h3><table style='${table}'><thead><tr style='background:#f5f5f4;text-align:left'><th style='padding:9px 12px'>Field</th><th style='padding:9px 12px'>Extracted value</th><th style='padding:9px 12px'>Source</th></tr></thead><tbody>${extractedRows}</tbody></table><h3 style='margin:24px 0 10px;font-size:17px'>3. Review outcome</h3><table style='${table}'><tbody>${row('Risk',p.risk_level+' ('+p.risk_score+'/100)')}${row('Recommended action',p.recommended_decision)}${row('Final decision',decision)}${row('Policy signals',(p.reason_codes||[]).join(', ')||'None')}${row('Reviewer decision',d.human_decision||'Not required')}${row('Banking action',d.action+' (sandbox='+String(b.sandbox===true)+')')}</tbody></table><p style='margin:20px 0 0;color:#78716c;font-size:12px'>\u003cstrong\u003e4. Deploy to Orchestrator after this debug\u003c/strong\u003e\u003cbr\u003e1. Open Studio Web and select WireSentinelChallenge117UiFinal.\u003cbr\u003e2. Click Publish and choose the target Orchestrator folder.\u003cbr\u003e3. Confirm mappings for Gmail, Google Sheets, Data Fabric, Attachment Adapter, IXP Adapter, and Banking Adapter.\u003cbr\u003e4. Publish the solution package, then enable the Gmail trigger in Orchestrator.\u003cbr\u003e5. Send the two-PDF Medium test and monitor Orchestrator Jobs plus Action Center.\u003cbr\u003e\u003cbr\u003eThis Studio Web Debug validation did not publish or deploy the Flow. Raw technical JSON remains in the WireSentinel audit record.</p></div></div>`;return{final_status:status,risk_level:p.risk_level,decision:decision,case_id:p.case_id,audit_record:audit,case:caseUpdate,audit:audit,notification_html:html,banking_result:b};",
        "errorHandlingEnabled": true
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the script fails",
          "source": "=Error",
          "var": "error"
        }
