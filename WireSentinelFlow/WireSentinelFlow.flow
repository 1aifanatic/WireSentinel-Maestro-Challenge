    {
      "id": "policyDecision1",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "Deterministic Policy and Risk",
        "icon": "code"
      },
      "inputs": {
        "script": "function parse(v){if(v&&typeof v==='object')return v;try{return JSON.parse(String(v||'{}').replace(/```json|```/gi,'').trim());}catch(e){return{};}}function val(v){if(v&&typeof v==='object'){if(v.value!==undefined)return v.value;if(v.Value!==undefined)return v.Value;if(v.text!==undefined)return v.text;}return v;}function num(v){var n=Number(String(val(v)||'').replace(/[^0-9.\\-]/g,''));return isFinite(n)?n:0;}function str(v){var x=val(v);return x===undefined||x===null?'':String(x).trim();}function dtype(d){return str(d.document_type||d.documentType||d.type||d.classification).toLowerCase().replace(/[^a-z]/g,'');}function rows(o){var v=(o&&o.values)||((o&&o.data&&o.data.values)?o.data.values:[]);if(!Array.isArray(v)||v.length<2)return[];var h=v[0].map(function(x){return String(x);});return v.slice(1).filter(function(r){return Array.isArray(r)&&r.length;}).map(function(r){var q={};h.forEach(function(k,i){q[k]=r[i];});return q;});}function isoCountry(v){var s=str(v).toUpperCase();var m={'UNITED STATES':'US','USA':'US','CANADA':'CA','UNITED ARAB EMIRATES':'AE','UAE':'AE','GERMANY':'DE','JAPAN':'JP','RUSSIA':'RU','IRAN':'IR','NORTH KOREA':'KP'};return m[s]||s;}var raw=($vars.document_pack&&Array.isArray($vars.document_pack.documents)&&$vars.document_pack.documents.length)?$vars.document_pack:(($vars.investigationAgent1&&$vars.investigationAgent1.output)?$vars.investigationAgent1.output:{});var pack=parse(raw.content!==undefined?raw.content:raw);var docs=Array.isArray(pack.documents)?pack.documents:[];var wireDocs=docs.filter(function(d){return dtype(d).indexOf('wire')>=0;});var invoiceDocs=docs.filter(function(d){return dtype(d).indexOf('invoice')>=0;});var wi=pack.wire_instruction||pack.wireInstruction||(wireDocs[0]&&wireDocs[0].extracted_fields)||null;var inv=pack.supporting_invoice||pack.supportingInvoice||(invoiceDocs[0]&&invoiceDocs[0].extracted_fields)||null;if(wi&&wi.extracted_fields)wi=wi.extracted_fields;if(wi&&wi.fields)wi=wi.fields;if(inv&&in